PORT=3000
PUBLIC_URL=
TTL_MINUTES=60
MAX_FILE_MB=200
CONCURRENCY=2
MAX_JOBS=10000
MAX_PLAYLIST_ITEMS=0
WORK_DIR=/tmp/alphame
CORS_ORIGIN=
ALLOW_PRIVATE_URLS=false

# youtube cookies (pick one, all optional)
# needed on datacenter IPs that get bot-verification from YouTube
YTDLP_COOKIES_PATH=
YTDLP_COOKIES=
YTDLP_COOKIES_BASE64=

# python interpreter override (default: python3 on linux, python on windows)
PYTHON_PATH=

SPOTIFY_DELAY_MS=200
