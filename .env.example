# All optional. Railway sets PORT automatically.
PORT=3000
# Public URL used when building direct links (defaults to the request host)
PUBLIC_URL=samp-ytm-production.up.railway.app
# Minutes before jobs, files and public links are deleted
TTL_MINUTES=60
# Per-file size limit and parallel encodes (keep CONCURRENCY low on small plans)
MAX_FILE_MB=200
CONCURRENCY=2
MAX_JOBS=10000
# 0 = no limit (fetch entire playlist); any positive number caps it
MAX_PLAYLIST_ITEMS=0
# Scratch directory (wiped on every start)
WORK_DIR=/tmp/alphame
# Only if the frontend is hosted on another origin (e.g. Vercel)
CORS_ORIGIN=
# Leave false in production (blocks private/internal addresses)
ALLOW_PRIVATE_URLS=false

# ── YouTube / yt-dlp cookie auth ─────────────────────────────────────────────
# Needed to bypass YouTube bot-verification on datacenter IPs (Railway, etc.)
# Pick ONE of the three methods:

# 1. Path to a Netscape-format cookies.txt file on the server
YTDLP_COOKIES_PATH=

# 2. Inline Netscape cookies content (paste the full file contents as one line)
YTDLP_COOKIES=

# 3. Base64-encoded cookies.txt — most convenient for Railway env vars
#    Generate with: base64 -w0 cookies.txt   (Linux/Mac)
#                   [Convert]::ToBase64String([IO.File]::ReadAllBytes('cookies.txt'))  (PowerShell)
YTDLP_COOKIES_BASE64=

# ── Python / Spotify ─────────────────────────────────────────────────────────
# Override Python interpreter (default: python3 on Linux, python on Windows)
PYTHON_PATH=

# Delay in ms between Spotify metadata API calls (default: 200)
SPOTIFY_DELAY_MS=200
